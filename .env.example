# Copiare in .env e sostituire i valori. Lo script scripts/setup.sh lo fa
# generando password casuali. Il file .env non va mai condiviso o versionato.

# --- Database (docker-compose.yml) ---
DB_PORT=54329
# Proprietario del database: usato solo per le migrazioni.
DB_ADMIN_PASSWORD=sostituire-con-password-lunga
# Ruolo applicativo, soggetto a Row Level Security: usato dal servizio.
DB_APP_PASSWORD=sostituire-con-altra-password-lunga

# Le URL contengono le stesse password in chiaro: il file .env non espande ${...}.
DATABASE_ADMIN_URL=postgresql://diario:sostituire-con-password-lunga@127.0.0.1:54329/diario
DATABASE_URL=postgresql://diario_app:sostituire-con-altra-password-lunga@127.0.0.1:54329/diario

# --- Storage privato degli audio originali ---
# Percorsi assoluti consigliati. Predefiniti: data/audio e data/tmp/uploads nel progetto.
# STORAGE_DIR=/percorso/del/progetto/data/audio
# UPLOAD_TMP_DIR=/percorso/del/progetto/data/tmp/uploads

# --- Servizio ---
# Ascolta solo su localhost. Il telefono arriva tramite Tailscale Serve (HTTPS): scripts/telefono.sh
HOST=127.0.0.1
PORT=8000
# true quando si accede via HTTPS (Tailscale). false solo per prove su http://localhost.
COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# --- Limiti di caricamento ---
# MAX_UPLOAD_BYTES=4294967296
# MAX_CHUNK_BYTES=33554432

LOG_LEVEL=INFO

# --- Elaborazione locale (Incremento 2) ---
# scripts/prepara-ai.sh prova i modelli e scrive qui il migliore che sta tutto nella scheda video.
# Per sceglierne uno a mano: OLLAMA_MODEL=... e OLLAMA_MODEL_FISSO=1
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_URL=http://127.0.0.1:11434
# Trascrizione: "auto" sceglie modello e precisione in base alla memoria video.
# WHISPER_MODEL=auto            # oppure large-v3, large-v3-turbo, medium, small
# WHISPER_DEVICE=auto           # auto | cuda | cpu
# WHISPER_LANGUAGE=it           # "auto" per riconoscerla
# Contesto massimo dell'analisi (token): oltre, il vocale si analizza a parti.
# ANALYSIS_MAX_CONTEXT=8192
# Argomenti: due nomi così simili (0–1) diventano lo stesso argomento.
# TOPIC_MERGE_SIMILARITY=0.86
# Riconoscimento di chi parla (preparato da scripts/prepara-ai.sh in .venv-voci).
# VOCI_PYTHON=.venv-voci/bin/python
# VOCI_MODELLO=data/modelli/pyannote-community-1
